COMPOSER_HOME=${COMPOSER_HOME:-$(composer global config home -q)}
[ -d $COMPOSER_HOME/vendor/magicoli/bash-tools/etc ] &&
	bash_tools_etc_dir="$COMPOSER_HOME/vendor/magicoli/bash-tools/etc" &&
	for file in \
		"${bash_tools_etc_dir}/profile.d"/* \
		"${bash_tools_etc_dir}/bash_completion.d"/*; do
		source "$file"
	done 2>/dev/null

for path in ~/.local/bin "$COMPOSER_HOME/vendor/bin" ~/bin; do
	[ -d "$path" ] || continue
	path=$(echo "$path" | sed "s:$HOME:~:")
	echo ":$PATH:" | grep -q ":$path:" || export PATH="$path:$PATH"
done

command -v emacs >/dev/null && EDITOR=${EDITOR:-emacs}
