for path in ~/.local/bin "$vendor_dir/bin" ~/bin; do
	[ -d "$path" ] || continue
	path=$(echo "$path" | sed "s:$HOME:~:")
	echo ":$PATH:" | grep -q ":$path:" || export PATH="$path:$PATH"
done

vendor_dir=$HOME/.composer/vendor
if [ -d $vendor_dir ]; then
	for file in \
		$vendor_dir/magicoli/bash-tools/etc/profile.d/* \
		$vendor_dir/magicoli/bash-tools/etc/bash_completion.d/*; do
		source "$file"
	done
fi

command -v emacs >/dev/null && EDITOR=${EDITOR:-emacs}
