set -u
self=$(realpath "${BASH_SOURCE:-$0}" 2>/dev/null)

deprecation="$(basename ${self}) is deprecated, use bash-helpers title_case function instead"
HELP="
$deprecation"

source "$(dirname $self)/bash-helpers"

title_case "$@"
log "[NOTICE] $deprecation"
